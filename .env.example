# Telegram Group ID (negative number for groups)
GROUP_CHAT_ID=-1004451334261

# Telethon API Credentials (for Message Export)
# Obtain from https://my.telegram.org -> API Development Tools
TELEGRAM_API_ID=12345678
TELEGRAM_API_HASH=your_api_hash_string_here
TELEGRAM_PHONE=+4917012345678

# Optional: Custom MTProto Server (default: official Telegram servers)
# TELEGRAM_MTPROTO_HOST=mtproxy.example.com
# TELEGRAM_MTPROTO_PORT=443

# LLM Configuration
LLM_BASE_URL=http://localhost:1234/v1
LLM_MODEL=gpt-4
OPENAI_API_KEY=dummy

# Database path (relative to project root)
# DB_PATH=data/groupbrain.db
