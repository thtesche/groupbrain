# Telegram Bot Credentials (für Bot-Operationen)
TELEGRAM_BOT_TOKEN=8926005100:AAAxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Telegram Group ID (negative Zahl für Gruppen)
GROUP_CHAT_ID=-1004451334261

# Telethon API Credentials (für Message-Export)
# Erhalten unter https://my.telegram.org -> API Development Tools
TELEGRAM_API_ID=12345678
TELEGRAM_API_HASH=your_api_hash_string_here
TELEGRAM_PHONE=+4917012345678

# Optional: Custom MTProto Server (Standard: offizielle Telegram-Server)
# TELEGRAM_MTPROTO_HOST=mtproxy.example.com
# TELEGRAM_MTPROTO_PORT=443
