# GroupBrain — Environment Variables
# Copy this to .env and fill in your values

TELEGRAM_BOT_TOKEN=your_bot_token_here
GROUP_CHAT_ID=-111_your_id
DB_PATH=~/.hermes/data/groupbrain.db

# LLM for extraction (local server like LM Studio, Ollama, etc.)
LLM_BASE_URL=http://localhost:1234/v1
LLM_MODEL=qwen/qwen3.6-35b-a3b
